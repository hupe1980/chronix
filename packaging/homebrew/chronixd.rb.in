# Generated by packaging/homebrew/formula.sh for chronixd @VERSION@; do not edit.
class Chronixd < Formula
  desc "Embedded time-series database server: PromQL, SQL, InfluxDB and Prometheus remote write"
  homepage "https://hupe1980.github.io/chronix/"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/chronix/releases/download/v@VERSION@/chronixd-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/chronix/releases/download/v@VERSION@/chronixd-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/hupe1980/chronix/releases/download/v@VERSION@/chronixd-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "chronixd"
  end

  def caveats
    <<~EOS
      Try it with a generated week of gateway data:
        chronixd --demo
      then open the console URL it prints.
    EOS
  end

  test do
    assert_match "chronixd #{version}", shell_output("#{bin}/chronixd --version")
  end
end
