{
  "uid": "chronix-demo",
  "title": "Gateway demo",
  "tags": [
    "chronix",
    "demo"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "PV power",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chronix"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(pv_power_w[10m])",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "chronix"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#f2a900"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
